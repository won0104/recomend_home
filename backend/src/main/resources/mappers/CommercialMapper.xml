<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.prj.model.mapper.CommercialMapper">

    <resultMap id="commercialMap" type="Commercial">
        <id column="shop_no" property="shopNo" />
        <result column="shop_name" property="shopName" />
        <result column="branch_name" property="branchName" />
        <result column="category_l_code" property="categoryLCode" />
        <result column="category_l_name" property="categoryLName" />
        <result column="category_m_code" property="categoryMCode" />
        <result column="category_m_name" property="categoryMName" />
        <result column="category_s_code" property="categorySCode" />
        <result column="category_s_name" property="categorySName" />
        <result column="std_industry_code" property="stdIndustryCode" />
        <result column="std_industry_name" property="stdIndustryName" />
        <result column="sido_code" property="sidoCode" />
        <result column="sido_name" property="sidoName" />
        <result column="sigungu_code" property="sigunguCode" />
        <result column="sigungu_name" property="sigunguName" />
        <result column="haengjeong_code" property="haengjeongCode" />
        <result column="haengjeong_name" property="haengjeongName" />
        <result column="beopjeong_code" property="beopjeongCode" />
        <result column="beopjeong_name" property="beopjeongName" />
        <result column="jibun_address" property="jibunAddress" />
        <result column="road_address" property="roadAddress" />
        <result column="building_name" property="buildingName" />
        <result column="longitude" property="longitude" />
        <result column="latitude" property="latitude" />
    </resultMap>

    <select id="search" parameterType="CommercialSearchCondition" resultMap="commercialMap" timeout="15">
        SELECT
            shop_no,
            shop_name,
            branch_name,
            category_l_code,
            category_l_name,
            category_m_code,
            category_m_name,
            category_s_code,
            category_s_name,
            std_industry_code,
            std_industry_name,
            sido_code,
            sido_name,
            sigungu_code,
            sigungu_name,
            haengjeong_code,
            haengjeong_name,
            beopjeong_code,
            beopjeong_name,
            jibun_address,
            road_address,
            building_name,
            longitude,
            latitude
        FROM commercials
        <where>
            <if test="sigunguCode != null and sigunguCode.trim() != ''">
                AND sigungu_code = #{sigunguCode}
            </if>
            <if test="beopjeongName != null and beopjeongName.trim() != ''">
                AND beopjeong_name LIKE CONCAT('%', #{beopjeongName}, '%')
            </if>
            <if test="categoryLCode != null and categoryLCode.trim() != ''">
                AND category_l_code = #{categoryLCode}
            </if>
            <if test="categoryMCode != null and categoryMCode.trim() != ''">
                AND category_m_code = #{categoryMCode}
            </if>
            <if test="keyword != null and keyword.trim() != ''">
                AND (shop_name LIKE CONCAT('%', #{keyword}, '%')
                     OR branch_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY shop_name ASC
        LIMIT #{limit}
    </select>

    <select id="findCategoryLargeList" resultType="map">
        SELECT
            category_code AS code,
            category_name AS name
        FROM commercial_categories
        ORDER BY category_code
    </select>

    <select id="findCategoryLargeFallbackList" resultType="map">
        SELECT DISTINCT
            category_l_code AS code,
            category_l_name AS name
        FROM commercials
        WHERE category_l_code IS NOT NULL
        ORDER BY category_l_code
    </select>

    <select id="findCategoryMediumList" parameterType="string" resultType="map">
        SELECT DISTINCT
            category_m_code AS code,
            category_m_name AS name
        FROM commercials
        WHERE category_m_code IS NOT NULL
        <if test="_parameter != null and _parameter.trim() != ''">
            AND category_l_code = #{categoryLCode}
        </if>
        ORDER BY category_m_code
    </select>
</mapper>
