<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.prj.model.mapper.UserAccountMapper">

    <resultMap id="userAccountMap" type="UserAccount">
        <id column="user_id" property="userId" />
        <result column="name" property="name" />
        <result column="email" property="email" />
        <result column="phone" property="phone" />
        <result column="password_hash" property="passwordHash" />
        <result column="role" property="role" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <sql id="userColumns">
        user_id,
        name,
        email,
        phone,
        password_hash,
        COALESCE(role, 'USER') AS role,
        DATE_FORMAT(created_at, '%Y-%m-%dT%H:%i:%s') AS created_at,
        DATE_FORMAT(updated_at, '%Y-%m-%dT%H:%i:%s') AS updated_at
    </sql>

    <select id="findAll" resultMap="userAccountMap">
        SELECT
        <include refid="userColumns" />
        FROM users
        ORDER BY created_at ASC
    </select>

    <select id="findByUserId" parameterType="string" resultMap="userAccountMap">
        SELECT
        <include refid="userColumns" />
        FROM users
        WHERE user_id = #{userId}
    </select>

    <insert id="insert" parameterType="UserAccount">
        INSERT INTO users (
            user_id,
            name,
            email,
            phone,
            password_hash,
            role,
            created_at,
            updated_at
        ) VALUES (
            #{userId},
            #{name},
            #{email},
            #{phone},
            #{passwordHash},
            COALESCE(#{role}, 'USER'),
            NOW(),
            NOW()
        )
    </insert>

    <update id="update" parameterType="UserAccount">
        UPDATE users
        SET name = #{name},
            email = #{email},
            phone = #{phone},
            password_hash = #{passwordHash},
            updated_at = NOW()
        WHERE user_id = #{userId}
    </update>

    <update id="updateRole">
        UPDATE users
        SET role = #{role},
            updated_at = NOW()
        WHERE user_id = #{userId}
    </update>

    <delete id="delete" parameterType="string">
        DELETE FROM users
        WHERE user_id = #{userId}
    </delete>
</mapper>
